#!/bin/bash

# Simple one-step RPM package builder for bash scripts
# Usage: ./build_rpm.sh <your_script.sh> [package_name]

set -e

if [ $# -lt 1 ]; then
    echo "Usage: $0 <bash_script> [package_name]"
    echo "Example: $0 myscript.sh mytool"
    exit 1
fi

SCRIPT_PATH="$1"
SCRIPT_NAME=$(basename "$1")
PACKAGE_NAME="${2:-${SCRIPT_NAME%.*}}"
VERSION="1.0"
RELEASE="1"

# Detect host architecture for the RPM (script itself is noarch)
HOST_ARCH="$(uname -m)"

TEMP_DIR="/tmp/rpm_build_$$"

cleanup() { rm -rf "$TEMP_DIR"; }
trap cleanup EXIT

echo "Building RPM package for: $SCRIPT_NAME"

# Check rpmbuild is available
if ! command -v rpmbuild >/dev/null 2>&1; then
    echo "Error: rpmbuild is not installed."
    echo "Install with: sudo dnf install rpm-build   (Fedora/RHEL)"
    echo "         or: sudo zypper install rpm-build (openSUSE)"
    echo "         or: sudo apt install rpm          (Debian/Ubuntu)"
    exit 1
fi

if [ ! -f "$SCRIPT_PATH" ]; then
    echo "Error: Script not found!"
    exit 1
fi

# ---------------------------------------------------------------------------
# Create the rpmbuild workspace
# ---------------------------------------------------------------------------

RPMBUILD_DIR="$TEMP_DIR/rpmbuild"

mkdir -p "$RPMBUILD_DIR/BUILD"
mkdir -p "$RPMBUILD_DIR/BUILDROOT"
mkdir -p "$RPMBUILD_DIR/RPMS"
mkdir -p "$RPMBUILD_DIR/SOURCES"
mkdir -p "$RPMBUILD_DIR/SPECS"
mkdir -p "$RPMBUILD_DIR/SRPMS"

# ---------------------------------------------------------------------------
# Prepare the source tarball (required by rpmbuild)
#
# rpmbuild expects:  SOURCES/<name>-<version>/...
# ---------------------------------------------------------------------------

STAGE_TOP="$RPMBUILD_DIR/SOURCES/${PACKAGE_NAME}-${VERSION}"

mkdir -p "$STAGE_TOP"

# Copy the script and prepare shebang
cp "$SCRIPT_PATH" "$STAGE_TOP/$PACKAGE_NAME"
chmod +x "$STAGE_TOP/$PACKAGE_NAME"

# Ensure shebang exists
if ! head -1 "$STAGE_TOP/$PACKAGE_NAME" | grep -q "^#!"; then
    sed -i '1i#!/bin/bash' "$STAGE_TOP/$PACKAGE_NAME"
fi

# Create the source tarball
tar -czf "$RPMBUILD_DIR/SOURCES/${PACKAGE_NAME}-${VERSION}.tar.gz" \
    -C "$RPMBUILD_DIR/SOURCES" \
    "${PACKAGE_NAME}-${VERSION}"

# ---------------------------------------------------------------------------
# Create the RPM spec file
# ---------------------------------------------------------------------------

SPEC_FILE="$RPMBUILD_DIR/SPECS/${PACKAGE_NAME}.spec"

cat > "$SPEC_FILE" << EOF
Name:           ${PACKAGE_NAME}
Version:        ${VERSION}
Release:        ${RELEASE}%{?dist}
Summary:        Automated RPM package for ${SCRIPT_NAME}

License:        MIT
BuildArch:      noarch
Requires:       bash

Source0:        %{name}-%{version}.tar.gz

%global _buildhost localhost

%description
This is an automated package for ${SCRIPT_NAME}.

%prep
%setup -q

%build
# Nothing to build (pure shell script)

%install
rm -rf %{buildroot}

# Install the script as an executable
mkdir -p %{buildroot}%{_bindir}
install -m 0755 %{name} %{buildroot}%{_bindir}/%{name}

%files
%{_bindir}/%{name}

%changelog
* $(LC_ALL=C date "+%a %b %d %Y") ${USER} - ${VERSION}-${RELEASE}
- Initial RPM package for ${SCRIPT_NAME}
EOF

# ---------------------------------------------------------------------------
# Build the RPM
# ---------------------------------------------------------------------------

echo "Building package..."

rpmbuild \
    --define "_topdir $RPMBUILD_DIR" \
    --define "_sourcedir $RPMBUILD_DIR/SOURCES" \
    --define "_specdir $RPMBUILD_DIR/SPECS" \
    --define "_builddir $RPMBUILD_DIR/BUILD" \
    --define "_rpmdir $RPMBUILD_DIR/RPMS" \
    --define "_srcrpmdir $RPMBUILD_DIR/SRPMS" \
    -bb "$SPEC_FILE"

# ---------------------------------------------------------------------------
# Copy the generated .rpm to the current directory
# ---------------------------------------------------------------------------

GENERATED_RPM=$(find "$RPMBUILD_DIR/RPMS" -type f -name "${PACKAGE_NAME}-${VERSION}-${RELEASE}*.rpm" | head -n 1)

if [ -z "$GENERATED_RPM" ] || [ ! -f "$GENERATED_RPM" ]; then
    echo "Error: Generated .rpm was not found."
    exit 1
fi

OUTPUT_RPM="${PACKAGE_NAME}-${VERSION}-${RELEASE}.noarch.rpm"

cp -f "$GENERATED_RPM" "$OUTPUT_RPM"

echo ""
echo "Package created: $OUTPUT_RPM"
echo ""
echo "Install: sudo rpm -ivh $OUTPUT_RPM"
echo "     or: sudo dnf install ./$OUTPUT_RPM"
echo ""
echo "Remove:  sudo rpm -e $PACKAGE_NAME"
echo "     or: sudo dnf remove $PACKAGE_NAME"
