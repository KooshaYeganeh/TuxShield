#!/usr/bin/env bash
#
# sa.sh — Cross‑distro security scanner installer/runner
# Supports: Debian/Ubuntu, Fedora/RHEL/Rocky, openSUSE
#

# Detect package manager
detect_pkg_mgr() {
    if command -v apt >/dev/null 2>&1; then
        PKG="apt"
    elif command -v dnf >/dev/null 2>&1; then
        PKG="dnf"
    elif command -v yum >/dev/null 2>&1; then
        PKG="yum"
    elif command -v zypper >/dev/null 2>&1; then
        PKG="zypper"
    else
        echo "Unsupported distro or package manager not found."
        exit 1
    fi
}

# Install a package using the detected pkg manager
install_pkg() {
    local pkg="$1"
    case "$PKG" in
        apt)
            sudo apt update -y
            sudo apt install -y "$pkg"
            ;;
        dnf)
            sudo dnf install -y "$pkg"
            ;;
        yum)
            sudo yum install -y "$pkg"
            ;;
        zypper)
            sudo zypper -n install "$pkg"
            ;;
    esac
}

# Check if installed
is_installed() {
    command -v "$1" >/dev/null 2>&1
}

# Install and configure each scanner
ensure_clamav() {
    if ! is_installed clamscan; then
        echo "Installing ClamAV..."
        install_pkg clamav
        if ! is_installed freshclam; then
            install_pkg clamav-daemon
        fi
        sudo freshclam
    fi
}

ensure_rkhunter() {
    if ! is_installed rkhunter; then
        echo "Installing rkhunter..."
        install_pkg rkhunter
    fi
}

ensure_chkrootkit() {
    if ! is_installed chkrootkit; then
        echo "Installing chkrootkit..."
        install_pkg chkrootkit
    fi
}

ensure_maldet() {
    if ! is_installed maldet; then
        echo "Installing maldet..."
        install_pkg wget
        cd /tmp || return
        wget -q http://www.rfxn.com/downloads/maldetect-current.tar.gz
        tar xzf maldetect-current.tar.gz
        cd maldetect-*
        sudo ./install.sh
        # initialize
        sudo /usr/local/sbin/maldet --mkpubpaths
        sudo /usr/local/sbin/maldet -u
    fi
}

ensure_lynis() {
    if ! is_installed lynis; then
        echo "Installing Lynis..."
        install_pkg lynis
    fi
}

ensure_tripwire() {
    if ! is_installed tripwire; then
        echo "Installing Tripwire..."
        install_pkg tripwire
        # Note: Tripwire requires policy initialization after installation
        echo "Tripwire installed. Configure policies manually."
    fi
}

ensure_unhide() {
    if ! is_installed unhide; then
        echo "Installing Unhide..."
        install_pkg unhide
    fi
}

# Run all scanners
scan_all() {
    echo "Running full scan..."
    sudo clamscan --infected --recursive /
    sudo /usr/local/sbin/maldet -a /
    sudo rkhunter --update
    sudo rkhunter --check --skip-keypress
    sudo chkrootkit
    sudo lynis audit system
    sudo tripwire --check
    sudo unhide quick
}

# Update tools (signatures etc.)
update_tools() {
    echo "Updating scanner databases..."
    sudo freshclam
    sudo /usr/local/sbin/maldet -u
    sudo rkhunter --update
    echo "Updates completed."
}

# Main
detect_pkg_mgr

case "$1" in
    -a|--all)
        ensure_clamav
        ensure_rkhunter
        ensure_chkrootkit
        ensure_maldet
        ensure_lynis
        ensure_tripwire
        ensure_unhide
        scan_all
        ;;
    -u|--update)
        update_tools
        ;;
    -h|--help)
        cat <<EOF
Usage: tuxshield [option]
-a  | --all      Install & run all tools
-u  | --update   Update signatures & definitions
-h  | --help     Show this help
EOF
        ;;
    *)
        echo "Invalid option. See --help."
        exit 1
        ;;
esac

